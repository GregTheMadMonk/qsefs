module;

#include <sys/stat.h>

export module qsefs.fuse;

import stl;

import qsefs.cue;

namespace qsefs {

export
class FUSE {
private:
    struct CueCacheEntry {
        using Data = std::expected<Cue, std::string>;
        stdc::time_point<stdc::steady_clock> fetched;
        Data                                 data;
    }; // <-- struct CueCacheEntry

public:
    static FUSE& get();

    void set_source(const stdfs::path& p);
    void set_target(const stdfs::path& p);

    inline void set_ignore_dotfiles(bool b) { this->ignore_dotfiles = b; }
    inline void set_cache_size(uz sz) { this->max_cached_files = sz; }
    // TODO: should this also affect hidden_files?
    inline void set_show_base_files(bool b) { this->show_base_files = b; }

    int run();

private:
    FUSE() = default;

    FUSE(const FUSE&)            = delete;
    FUSE& operator=(const FUSE&) = delete;

    using DirEntry = std::string;

    [[nodiscard]]
    std::expected<std::vector<DirEntry>, int>
    read_dir(const stdfs::path& dir) const;

    [[nodiscard]]
    const CueCacheEntry::Data& read_cue(const stdfs::path& cue) const;

    /**
     * @brief Get track from filename and CUE name
     *
     * @param path track path in the virtual filesystem
     * @param cue  CUE virtual directory path. This parameter is, strictly
     *             speaking, redundant, and is just equal to the parent of
     *             `path`. Used to avoid double work at call site
     */
    [[nodiscard]]
    std::optional<const Cue::Track&>
    get_track(const stdfs::path& path, const stdfs::path& cue) const;

    [[nodiscard]]
    std::optional<struct stat> getattr(const stdfs::path& p) const;

    [[nodiscard]]
    int read(const stdfs::path& p, std::span<char> buf, off_t offset) const;

    [[nodiscard]]
    std::optional<stdfs::path> real_path(const stdfs::path& p) const;

    /**
     * @brief Housekeep the cache, remove old (or oldest) entries)
     */
    void flush_cache() const;

    stdfs::path source_path;
    stdfs::path target_path;
    bool        ignore_dotfiles;
    uz          max_cached_files;
    bool        show_base_files;

    mutable
    std::unordered_map<std::string, CueCacheEntry> cache;

    mutable
    std::unordered_set<stdfs::path> hidden_files;
}; // <-- class FUSE

} // <-- namespace qsefs
