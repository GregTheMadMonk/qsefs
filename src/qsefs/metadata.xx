export module qsefs.metadata;

import dxx.utils;
import stl;

namespace qsefs {

export struct WavTag { std::array<char, 4> tag; };

export
template <typename Char, uz sz>
struct CueTag { dxx::utils::FixedString<Char, sz> tag; };

[[nodiscard]]
consteval
WavTag wav_tag(const char (&str)[5]) {
    WavTag ret{};
    std::copy_n(str, 4, ret.tag.begin());
    return ret;
} // <-- WavTag wav_tag(str[len])

template <dxx::utils::FixedString fs>
constexpr CueTag cue_tag{ fs };

/**
 * @brief Track metadata
 */
export
struct Metadata {
    [[=wav_tag("IART"), =cue_tag<"PERFORMER">]]
    std::string artist;
    [[=wav_tag("INAM")]]
    std::string title;
    [[=wav_tag("IPRD")]]
    std::string album;
    [[=wav_tag("IGNR"), =cue_tag<"GENRE">]]
    std::string genre;
    [[=cue_tag<"DISCID">]]
    std::string disc_id;
    [[=wav_tag("ICMT"), =cue_tag<"COMMENT">]]
    std::string comment;
    [[=cue_tag<"COMPOSER">]]
    std::string composer;
    [[=wav_tag("ISRC"), =cue_tag<"ISRC">]]
    std::string isrc;
    [[=wav_tag("ICRD"), =cue_tag<"DATE">]]
    int         year;
    [[=wav_tag("ITRK"), =wav_tag("TRCK"), =wav_tag("IPRT")]]
    uz          index;
}; // <-- struct Metadata

} // <-- namespace qsefs
